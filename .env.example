# Copy this file to .env.local for local development.
# In Vercel, add these under Project Settings -> Environment Variables instead.

# From your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# From https://www.football-data.org/client/register (free, no card)
# NOTE: this one has no VITE_ prefix on purpose — it's read only by the
# serverless function in /api, never sent to the browser.
FOOTBALL_DATA_TOKEN=your-football-data-org-token
